# Dependencies and package manager output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets
# Keep developer machine secrets out of Git, but allow checked-in templates.
.env
.env.*
.env.local
!.env.example

# Build and cache output
dist/
build/
.cache/
.vite/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python static-server cache
__pycache__/
*.py[cod]
